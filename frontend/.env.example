# ------------------------------------------------------------------
# E-Rakshan Frontend - environment template
# Copy to `.env` and adjust. All VITE_ vars are baked into the bundle.
# ------------------------------------------------------------------

# App identity
VITE_APP_NAME=E-Rakshan
VITE_APP_TAGLINE=Hazard-to-Relocation Decision Support

# Backend API (FastAPI). Leave empty in DEMO mode.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket events channel (alerts, telemetry). Unused in DEMO mode.
VITE_WS_URL=ws://localhost:8000/api/v1/events

# DEMO_MODE=true => all data comes from /public/demo-data + in-browser mock
# engines (risk, optimizer, websocket). No backend required.
VITE_DEMO_MODE=true

# Default basemap (osm | dark | satellite)
VITE_DEFAULT_BASEMAP=dark

# Mock websocket cadence (ms) for simulated alerts/telemetry
VITE_MOCK_WS_INTERVAL_MS=6000

# Optional: ISRO Bhuvan / NASA FIRMS reference links shown in the UI
VITE_BHUVAN_PORTAL=https://bhuvan-app1.nrsc.gov.in/
VITE_FIRMS_PORTAL=https://firms.modaps.eosdis.nasa.gov/map/

# ------------------------------------------------------------------
# SAHAY - Ollama (local LLM) fallback
# Used ONLY when the deterministic command engine (commandEngine.js)
# can't match the user's query - e.g. general knowledge questions.
# Requires a local Ollama server: https://ollama.com
# ------------------------------------------------------------------
VITE_OLLAMA_URL=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2
VITE_OLLAMA_ENABLED=true


# SAHAY - local Jarvis-style voice bridge
VITE_SAHAY_VOICE_WS=ws://127.0.0.1:8787/ws
